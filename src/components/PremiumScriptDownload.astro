---
/**
 * Premium Python starter script – Kauf über Lemon Squeezy + geschützter Download.
 *
 * Ablauf:
 *   1. Besucher kauft das Skript-Paket über Lemon Squeezy (19,99 €).
 *   2. Lemon Squeezy stellt einen Lizenzschlüssel aus.
 *   3. Der Besucher gibt den Schlüssel hier ein.
 *   4. Das Frontend ruft den Download-Gate-Worker (`/api/validate`) auf.
 *   5. Der Worker prüft die Lizenz und gibt ein kurzlebiges Token zurück.
 *   6. Die Download-Links zeigen auf `/api/script?token=…&slug=…&file=py|readme`.
 *
 * Ohne gültige Lizenz liefert der Worker keine Datei.
 */
import LemonButton from "./LemonButton.astro";

interface Props {
  slug: string;
  title: string;
  price?: string;
  checkoutUrl?: string;
}

const {
  slug,
  title,
  price = "€19.99",
  checkoutUrl,
} = Astro.props;

const gateUrl = (import.meta.env.PUBLIC_DOWNLOAD_GATE_URL ?? "").trim();
const resolvedCheckoutUrl =
  checkoutUrl ??
  import.meta.env.PUBLIC_LEMON_SCRIPT_CHECKOUT_URL ??
  import.meta.env.PUBLIC_LEMON_CHECKOUT_URL;
---

<section
  class="mt-6 overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-500/10 via-surface to-cyan-500/5"
  data-premium-script
  data-slug={slug}
  data-gate-url={gateUrl}
>
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center rounded-full bg-brand-500/15 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-brand-200 ring-1 ring-inset ring-brand-500/30">
        Premium script
      </span>
      <span class="text-xs text-slate-500">Sofort-Download · {price}</span>
    </div>

    <h2 class="mt-3 text-xl font-semibold text-white">
      Python starter script
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-400">
      A minimal, dependency-free client for {title}. It ships with
      <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-xs text-brand-300">--dry-run</code>,
      <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-xs text-brand-300">--smoke</code> and
      <code class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-xs text-brand-300">--live</code>
      modes and only uses the Python standard library.
    </p>

    <!-- Kauf -->
    <div class="mt-5" data-locked>
      <LemonButton
        label={`Skript kaufen – ${price}`}
        price="Einmalzahlung · Python-Download"
        productName={`${title} – Python Starter Script`}
        checkoutUrl={resolvedCheckoutUrl}
        note="Sichere Zahlung über Lemon Squeezy · Lizenzschlüssel kommt per E-Mail"
      />

      <div class="mt-5 rounded-xl border border-white/10 bg-white/[0.03] p-4">
        <p class="text-sm font-medium text-white">Bereits gekauft?</p>
        <p class="mt-1 text-xs text-slate-400">
          Gib deinen Lemon-Squeezy-Lizenzschlüssel ein, um das Skript freizuschalten.
        </p>
        <form class="mt-3 flex flex-col gap-2 sm:flex-row" data-license-form>
          <label class="sr-only" for={`script-license-${slug}`}>Lizenzschlüssel</label>
          <input
            id={`script-license-${slug}`}
            name="licenseKey"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="XXXX-XXXX-XXXX-XXXX"
            class="w-full flex-1 rounded-lg border border-white/10 bg-[#06070d] px-3 py-2.5 font-mono text-sm text-white placeholder:text-slate-600 focus:border-brand-400/60 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
            data-license-input
          />
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-400 disabled:cursor-not-allowed disabled:opacity-60"
            data-license-submit
          >
            Skript freischalten
          </button>
        </form>
        <p class="mt-2 hidden text-xs text-rose-300" role="alert" data-license-error></p>
        <p class="mt-2 hidden text-xs text-slate-400" data-license-status></p>
      </div>
    </div>

    <!-- Freigeschaltet -->
    <div class="mt-5 hidden" data-unlocked>
      <div class="flex flex-wrap gap-3">
        <a
          href="#"
          download
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-emerald-500/25 transition-colors hover:bg-emerald-400"
          data-download-py
        >
          Download .py
        </a>
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
          data-download-readme
        >
          Read the README
        </a>
      </div>
      <p class="mt-3 text-xs text-slate-500">
        Lizenz bestätigt. Die Download-Links sind aus Sicherheitsgründen
        kurzzeitig gültig.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function boot() {
      var roots = document.querySelectorAll("[data-premium-script]");
      if (!roots.length) return;

      roots.forEach(function (root) {
        var slug = root.dataset.slug;
        var gateUrl = (root.dataset.gateUrl || "").replace(/\/$/, "");
        var storageKey = "flowmatrix:script-license:" + slug;

        var form = root.querySelector("[data-license-form]");
        var input = root.querySelector("[data-license-input]");
        var submit = root.querySelector("[data-license-submit]");
        var errorEl = root.querySelector("[data-license-error]");
        var statusEl = root.querySelector("[data-license-status]");
        var locked = root.querySelector("[data-locked]");
        var unlocked = root.querySelector("[data-unlocked]");
        var pyLink = root.querySelector("[data-download-py]");
        var readmeLink = root.querySelector("[data-download-readme]");

        function showError(message) {
          if (!errorEl) return;
          errorEl.textContent = message;
          errorEl.classList.remove("hidden");
        }

        function clearError() {
          if (!errorEl) return;
          errorEl.textContent = "";
          errorEl.classList.add("hidden");
        }

        function setStatus(message) {
          if (!statusEl) return;
          statusEl.textContent = message || "";
          statusEl.classList.toggle("hidden", !message);
        }

        function setBusy(busy) {
          if (submit) {
            submit.disabled = busy;
            submit.textContent = busy ? "Prüfe Lizenz …" : "Skript freischalten";
          }
        }

        function unlock(token) {
          var base =
            gateUrl +
            "/api/script?token=" +
            encodeURIComponent(token) +
            "&slug=" +
            encodeURIComponent(slug);
          if (pyLink) pyLink.setAttribute("href", base + "&file=py");
          if (readmeLink) readmeLink.setAttribute("href", base + "&file=readme");
          if (locked) locked.classList.add("hidden");
          if (unlocked) unlocked.classList.remove("hidden");
          setStatus("");
          clearError();
        }

        function remember(key) {
          try {
            localStorage.setItem(storageKey, key);
          } catch (error) {
            /* localStorage may be unavailable */
          }
        }

        function forget() {
          try {
            localStorage.removeItem(storageKey);
          } catch (error) {
            /* ignore */
          }
        }

        function validate(licenseKey, options) {
          var silent = options && options.silent;
          if (!gateUrl) {
            if (!silent) {
              showError(
                "Der Download-Server ist noch nicht konfiguriert. Bitte später erneut versuchen."
              );
            }
            return Promise.resolve(false);
          }

          if (!silent) {
            clearError();
            setBusy(true);
            setStatus("Lizenz wird geprüft …");
          }

          return fetch(gateUrl + "/api/validate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ licenseKey: licenseKey, slug: slug }),
          })
            .then(function (response) {
              return response.json().then(function (data) {
                return { ok: response.ok, data: data };
              });
            })
            .then(function (result) {
              var data = result.data || {};
              if (result.ok && data.valid && data.token) {
                remember(licenseKey);
                unlock(data.token);
                return true;
              }
              if (!silent) {
                showError(
                  data.error ||
                    "Lizenzschlüssel ist ungültig oder nicht aktiv."
                );
                setStatus("");
              }
              return false;
            })
            .catch(function () {
              if (!silent) {
                showError(
                  "Lizenzprüfung fehlgeschlagen. Bitte Verbindung prüfen und erneut versuchen."
                );
                setStatus("");
              }
              return false;
            })
            .finally(function () {
              if (!silent) setBusy(false);
            });
        }

        if (form) {
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var value = (input && input.value ? input.value : "").trim();
            if (!value) {
              showError("Bitte einen Lizenzschlüssel eingeben.");
              return;
            }
            validate(value);
          });
        }

        var stored = null;
        try {
          stored = localStorage.getItem(storageKey);
        } catch (error) {
          stored = null;
        }
        if (stored) {
          if (input) input.value = stored;
          validate(stored, { silent: true }).then(function (ok) {
            if (!ok) forget();
          });
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
