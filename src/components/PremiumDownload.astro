---
/**
 * Premium PDF purchase + geschützter Download.
 *
 * Ablauf:
 *   1. Besucher kauft das PDF über Lemon Squeezy (Preis je nach Schwierigkeit).
 *   2. Lemon Squeezy stellt einen Lizenzschlüssel aus (per E-Mail / Checkout).
 *   3. Der Besucher gibt den Schlüssel hier ein.
 *   4. Das Frontend ruft den Download-Gate-Worker (`/api/validate`) auf.
 *      Der Worker prüft den Schlüssel gegen die Lemon-Squeezy-License-API und
 *      gibt ein kurzlebiges, signiertes Download-Token zurück.
 *   5. Der Download-Link zeigt auf `/api/download?token=…&slug=…`; der Worker
 *      streamt das PDF aus dem privaten R2-Bucket.
 *
 * Wichtig: Es gibt bewusst KEINEN clientseitigen „Unlock" mehr. Ohne gültige
 * Lizenz liefert der Worker kein PDF. Der Lizenzschlüssel wird nur lokal
 * gespeichert, um ihn beim nächsten Besuch erneut zu validieren – nicht der
 * Unlock-Status.
 */
import LemonButton from "./LemonButton.astro";
import {
  resolveDownloadGate,
  resolveWorkflowCheckout,
} from "../lib/monetization";
import { getWorkflowTier } from "../lib/pricing";

interface Props {
  slug: string;
  title: string;
  difficulty?: string;
  price?: string;
  checkoutUrl?: string;
}

const { slug, title, difficulty, price, checkoutUrl } = Astro.props;

const tier = getWorkflowTier(difficulty);
const resolvedPrice = price ?? tier.label;
const gateUrl = resolveDownloadGate();
const resolvedCheckoutUrl = resolveWorkflowCheckout(difficulty, checkoutUrl);
// Kauf und Lizenz-Unlock sind getrennte Fähigkeiten: Ohne echten Checkout
// darf kein Kauf-Button erscheinen, ohne Gate kein irreführendes Lizenzfeld.
const purchaseConfigured = resolvedCheckoutUrl.length > 0;
const gateConfigured = gateUrl.length > 0;
---

{(purchaseConfigured || gateConfigured) && (
  <section
    class="mt-10 overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-500/10 via-surface to-cyan-500/5"
    data-premium-download
    data-slug={slug}
    data-gate-url={gateUrl}
  >
    <div class="p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-brand-500/15 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-brand-200 ring-1 ring-inset ring-brand-500/30">
          IMPLEMENTATION KIT (PDF + CODE .ZIP)
        </span>
        <span class="text-xs text-slate-500">
          Sofort-Download · {resolvedPrice}
        </span>
      </div>

      <h2 class="mt-3 text-xl font-semibold text-white sm:text-2xl">
        {title} als Premium-Workflow
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">
        Enthält 100 % Python-Standardbibliotheks-Code, Architektur-PDF,
        .env.example, Mock-Daten, SQL-Schema, .http-Requests & fertigen
        AI-Agent-Prompt für Cursor/Roo Code.
      </p>
      <ul class="mt-4 grid gap-1 text-xs text-slate-400 sm:grid-cols-2">
        <li>📄 blueprint.pdf</li>
        <li>🐍 workflow.py</li>
        <li>🔑 .env.example</li>
        <li>🧪 mock_data.json</li>
        <li>🗄️ schema.sql</li>
        <li>🌐 requests.http</li>
        <li>🤖 AI_IMPLEMENTATION_PROMPT.md</li>
        <li>📝 README.md</li>
      </ul>

      <!-- Kauf / Lizenz-Unlock -->
      <div class="mt-6" data-locked>
        {purchaseConfigured ? (
          <LemonButton
            label={`Workflow & Skripte kaufen – ${resolvedPrice}`}
            price="Einmalzahlung · PDF-Download"
            productName={`${title} – Premium Workflow`}
            checkoutUrl={resolvedCheckoutUrl}
            note="Sichere Zahlung über Lemon Squeezy · Lizenzschlüssel kommt per E-Mail"
          />
        ) : (
          <p class="rounded-xl border border-amber-400/20 bg-amber-400/5 p-4 text-xs leading-relaxed text-amber-200/80">
            Der Verkauf wird gerade eingerichtet. Wenn du das PDF bereits
            gekauft hast, kannst du es unten mit deinem Lizenzschlüssel
            freischalten.
          </p>
        )}

        {purchaseConfigured && !gateConfigured && (
          <p class="mt-3 text-xs leading-relaxed text-slate-500">
            Nach dem Kauf erhältst du den PDF-Download direkt über Lemon
            Squeezy.
          </p>
        )}

        {gateConfigured && (
          <div class="mt-6 rounded-xl border border-white/10 bg-white/[0.03] p-4">
            <p class="text-sm font-medium text-white">Bereits gekauft?</p>
            <p class="mt-1 text-xs text-slate-400">
              Gib deinen Lemon-Squeezy-Lizenzschlüssel ein, um das PDF
              freizuschalten.
            </p>
            <form
              class="mt-3 flex flex-col gap-2 sm:flex-row"
              data-license-form
            >
              <label class="sr-only" for={`license-${slug}`}>
                Lizenzschlüssel
              </label>
              <input
                id={`license-${slug}`}
                name="licenseKey"
                type="text"
                autocomplete="off"
                spellcheck="false"
                placeholder="XXXX-XXXX-XXXX-XXXX"
                class="w-full flex-1 rounded-lg border border-white/10 bg-[#06070d] px-3 py-2.5 font-mono text-sm text-white placeholder:text-slate-600 focus:border-brand-400/60 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
                data-license-input
              />
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-400 disabled:cursor-not-allowed disabled:opacity-60"
                data-license-submit
              >
                Workflow & Skripte freischalten
              </button>
            </form>
            <p
              class="mt-2 hidden text-xs text-rose-300"
              role="alert"
              data-license-error
            ></p>
            <p
              class="mt-2 hidden text-xs text-slate-400"
              data-license-status
            ></p>
          </div>
        )}
      </div>

      <!-- Freigeschaltet -->
      <div class="mt-6 hidden" data-unlocked>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#"
            download
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-500/25 transition-colors hover:bg-emerald-400"
            data-download-kit
          >
            📦 Download Complete Implementation Kit (.zip)
          </a>
          <a
            href="#"
            download
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
            data-download-pdf
          >
            📄 Download Architecture Blueprint (.pdf)
          </a>
        </div>
        <p class="mt-3 text-xs text-slate-500">
          Lizenz bestätigt. Die Download-Links sind aus Sicherheitsgründen
          kurzzeitig gültig.
        </p>
      </div>
    </div>
  </section>
)}

<script is:inline>
  (function () {
    function boot() {
      var roots = document.querySelectorAll("[data-premium-download]");
      if (!roots.length) return;

      roots.forEach(function (root) {
        var slug = root.dataset.slug;
        var gateUrl = (root.dataset.gateUrl || "").replace(/\/$/, "");
        var storageKey = "flowmatrix:license:" + slug;

        var form = root.querySelector("[data-license-form]");
        var input = root.querySelector("[data-license-input]");
        var submit = root.querySelector("[data-license-submit]");
        var errorEl = root.querySelector("[data-license-error]");
        var statusEl = root.querySelector("[data-license-status]");
        var locked = root.querySelector("[data-locked]");
        var unlocked = root.querySelector("[data-unlocked]");
        var kitLink = root.querySelector("[data-download-kit]");
        var pdfLink = root.querySelector("[data-download-pdf]");

        function showError(message) {
          if (!errorEl) return;
          errorEl.textContent = message;
          errorEl.classList.remove("hidden");
        }

        function clearError() {
          if (!errorEl) return;
          errorEl.textContent = "";
          errorEl.classList.add("hidden");
        }

        function setStatus(message) {
          if (!statusEl) return;
          statusEl.textContent = message || "";
          statusEl.classList.toggle("hidden", !message);
        }

        function setBusy(busy) {
          if (submit) {
            submit.disabled = busy;
            submit.textContent = busy
              ? "Prüfe Lizenz …"
              : "Workflow & Skripte freischalten";
          }
        }

        function unlock(downloadUrl, kitUrl) {
          if (pdfLink) pdfLink.setAttribute("href", downloadUrl);
          if (kitLink) kitLink.setAttribute("href", kitUrl || downloadUrl);
          if (locked) locked.classList.add("hidden");
          if (unlocked) unlocked.classList.remove("hidden");
          setStatus("");
          clearError();
        }

        function remember(key) {
          try {
            localStorage.setItem(storageKey, key);
          } catch (error) {
            /* localStorage may be unavailable */
          }
        }

        function forget() {
          try {
            localStorage.removeItem(storageKey);
          } catch (error) {
            /* ignore */
          }
        }

        function validate(licenseKey, options) {
          var silent = options && options.silent;
          if (!gateUrl) {
            if (!silent) {
              showError(
                "Der Download-Server ist noch nicht konfiguriert. Bitte später erneut versuchen.",
              );
            }
            return Promise.resolve(false);
          }

          if (!silent) {
            clearError();
            setBusy(true);
            setStatus("Lizenz wird geprüft …");
          }

          return fetch(gateUrl + "/api/validate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ licenseKey: licenseKey, slug: slug }),
          })
            .then(function (response) {
              return response.json().then(function (data) {
                return { ok: response.ok, data: data };
              });
            })
            .then(function (result) {
              var data = result.data || {};
              if (result.ok && data.valid && data.downloadUrl) {
                remember(licenseKey);
                unlock(data.downloadUrl, data.kitUrl);
                return true;
              }
              if (!silent) {
                showError(
                  data.error ||
                    "Lizenzschlüssel ist ungültig oder nicht aktiv.",
                );
                setStatus("");
              }
              return false;
            })
            .catch(function () {
              if (!silent) {
                showError(
                  "Lizenzprüfung fehlgeschlagen. Bitte Verbindung prüfen und erneut versuchen.",
                );
                setStatus("");
              }
              return false;
            })
            .finally(function () {
              if (!silent) setBusy(false);
            });
        }

        if (form) {
          form.addEventListener("submit", function (event) {
            event.preventDefault();
            var value = (input && input.value ? input.value : "").trim();
            if (!value) {
              showError("Bitte einen Lizenzschlüssel eingeben.");
              return;
            }
            validate(value);
          });
        }

        // Beim Laden: gespeicherten Schlüssel erneut validieren (nicht den
        // Unlock-Status vertrauen).
        var stored = null;
        try {
          stored = localStorage.getItem(storageKey);
        } catch (error) {
          stored = null;
        }
        if (stored) {
          if (input) input.value = stored;
          validate(stored, { silent: true }).then(function (ok) {
            if (!ok) forget();
          });
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
  })();
</script>
