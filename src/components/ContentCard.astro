---
import Badge from "./Badge.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  meta?: string;
  tags?: string[];
  rating?: number;
}

const { href, title, description, meta, tags = [], rating } = Astro.props;
---

<a
  href={href}
  class="group card-hover flex flex-col rounded-2xl border border-white/10 bg-surface/60 p-6 backdrop-blur-sm"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-white transition-colors group-hover:text-brand-300">
      {title}
    </h3>
    {
      typeof rating === "number" && (
        <span class="inline-flex shrink-0 items-center gap-1 rounded-lg bg-amber-500/10 px-2 py-1 text-xs font-semibold text-amber-300 ring-1 ring-inset ring-amber-500/20">
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.2 2.74.99-5.79-4.21-4.1 5.82-.85L10 1.5z" />
          </svg>
          {rating.toFixed(1)}
        </span>
      )
    }
  </div>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">
    {description}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <Badge tone="slate">{tag}</Badge>
        ))}
      </div>
    )
  }

  <div class="mt-5 flex items-center justify-between border-t border-white/5 pt-4">
    <span class="text-xs font-medium text-slate-500">{meta}</span>
    <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-300 transition-transform group-hover:translate-x-0.5">
      Details
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
          clip-rule="evenodd"
        />
      </svg>
    </span>
  </div>
</a>
