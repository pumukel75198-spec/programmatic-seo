---
interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  badge?: string;
}

const {
  title = "Showcase your tool here",
  description = "Reach an audience of developers and SEO teams. We offer space for affiliate and sponsorship links.",
  ctaLabel = "Send request",
  ctaHref = "mailto:sponsoring@flowmatrix.com",
  badge = "Advertisement",
} = Astro.props;
---

<aside
  class="relative mt-12 overflow-hidden rounded-2xl border border-dashed border-brand-500/30 bg-gradient-to-br from-brand-500/10 via-surface to-cyan-500/5 p-6 sm:p-8"
>
  <div
    class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-brand-500/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <span
        class="inline-flex items-center rounded-full bg-white/5 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-slate-400 ring-1 ring-inset ring-white/10"
      >
        {badge}
      </span>
      <h2 class="mt-3 text-lg font-semibold text-white">{title}</h2>
      <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-slate-400">
        {description}
      </p>
    </div>

    <a
      href={ctaHref}
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:bg-brand-400"
    >
      {ctaLabel}
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  </div>
</aside>
