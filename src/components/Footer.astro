---
const year = new Date().getFullYear();
const links = [
  { href: "/apis", label: "APIs" },
  { href: "/alternativen", label: "Alternativen" },
  { href: "/workflows", label: "Workflows" },
];
---

<footer class="border-t border-white/5 bg-[#06070d]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="text-sm font-semibold text-white">Programmatic SEO Hub</p>
        <p class="mt-1 max-w-md text-sm text-slate-500">
          Kuratierte APIs, Alternativen und Workflows für moderne Produkt- und
          SEO-Teams.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer-Navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-slate-400 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 border-t border-white/5 pt-6">
      <p class="text-xs text-slate-600">
        © {year} Programmatic SEO Hub. Alle Angaben ohne Gewähr.
      </p>
    </div>
  </div>
</footer>
