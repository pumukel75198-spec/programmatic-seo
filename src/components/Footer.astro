---
const year = new Date().getFullYear();
const links = [
  { href: "/apis", label: "APIs", key: "nav.apis" },
  { href: "/alternatives", label: "Alternatives", key: "nav.alternatives" },
  { href: "/workflows", label: "Workflows", key: "nav.workflows" },
];
const legalLinks = [
  { href: "/imprint", label: "Imprint", key: "footer.imprint" },
  { href: "/privacy", label: "Privacy", key: "footer.privacy" },
];
---

<footer class="border-t border-white/5 bg-[#06070d]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="text-sm font-semibold text-white">Programmatic SEO Hub</p>
        <p class="mt-1 max-w-md text-sm text-slate-500" data-i18n="footer.tagline">
          Curated APIs, alternatives and workflows for modern product and SEO
          teams.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-i18n={link.key}
              class="text-sm text-slate-400 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-white/5 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-slate-600">
        © {year} Programmatic SEO Hub. All information without guarantee.
      </p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              data-i18n={link.key}
              class="text-xs text-slate-500 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
