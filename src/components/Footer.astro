---
import { t } from "../i18n/utils";

interface Props {
  lang?: string;
}

const lang = Astro.props.lang ?? "en";
const year = new Date().getFullYear();

const links = [
  { href: `/${lang}/apis`, label: t(lang, "nav.apis") },
  { href: `/${lang}/alternatives`, label: t(lang, "nav.alternatives") },
  { href: `/${lang}/workflows`, label: t(lang, "nav.workflows") },
];
const legalLinks = [
  { href: `/${lang}/imprint`, label: t(lang, "footer.imprint") },
  { href: `/${lang}/privacy`, label: t(lang, "footer.privacy") },
];
---

<footer class="border-t border-white/5 bg-[#06070d]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="notranslate text-sm font-semibold text-white" translate="no">FlowMatrix</p>
        <p class="mt-1 max-w-md text-sm text-slate-500">
          {t(lang, "footer.tagline")}
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-slate-400 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-white/5 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-slate-600">
        © {year} <span class="notranslate" translate="no">FlowMatrix</span>. All information without guarantee.
      </p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs text-slate-500 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
