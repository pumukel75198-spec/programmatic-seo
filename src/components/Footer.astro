---
import { t } from "../i18n/utils";

interface Props {
  lang?: string;
}

const lang = Astro.props.lang ?? "en";
const year = new Date().getFullYear();

const links = [
  { href: `/${lang}/apis`, label: t(lang, "nav.apis") },
  { href: `/${lang}/alternatives`, label: t(lang, "nav.alternatives") },
  { href: `/${lang}/workflows`, label: t(lang, "nav.workflows") },
  { href: "/insights", label: "Insights" },
  { href: `/${lang}/about`, label: "About" },
  { href: `/${lang}/support`, label: "Support" },
  { href: "https://compliance.flowmatrix.dev", label: "Compliance" },
];
const legalLinks = [
  { href: `/${lang}/author`, label: "Author" },
  { href: `/${lang}/editorial-policy`, label: "Editorial Policy" },
  { href: `/${lang}/affiliate-disclosure`, label: "Affiliate Disclosure" },
  { href: `/${lang}/imprint`, label: t(lang, "footer.imprint") },
  { href: `/${lang}/privacy`, label: t(lang, "footer.privacy") },
];
---

<footer class="border-t border-white/5 bg-[#06070d]">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="notranslate text-sm font-semibold text-white" translate="no">FlowMatrix</p>
        <p class="mt-1 max-w-md text-sm text-slate-500">
          {t(lang, "footer.tagline")}
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-slate-400 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-3 border-t border-white/5 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-slate-600">
        © {year} <span class="notranslate" translate="no">FlowMatrix</span>. All information without guarantee.
      </p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs text-slate-500 transition-colors hover:text-brand-300"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <div class="mt-6 flex items-center gap-2 text-xs text-slate-600">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
      <span
        id="visitor-counter"
        data-label={t(lang, "footer.visitors")}
        class="notranslate"
        translate="no"
      >
        {t(lang, "footer.visitors")}
      </span>
    </div>
  </div>
</footer>

<script>
  const counterEl = document.getElementById("visitor-counter");
  const endpoint = import.meta.env.PUBLIC_VISITOR_COUNTER_URL;

  if (counterEl) {
    if (!endpoint) {
      counterEl.parentElement?.setAttribute("hidden", "");
    } else {
      const base = endpoint.replace(/\/$/, "");
      const storageKey = "fm_visit_counted_at";
      const DAY = 24 * 60 * 60 * 1000;
      let lastCounted = 0;
      try {
        lastCounted = Number(localStorage.getItem(storageKey)) || 0;
      } catch (error) {
        /* localStorage may be unavailable */
      }
      const alreadyCounted = Date.now() - lastCounted < DAY;
      const url = alreadyCounted ? `${base}/count` : `${base}/hit`;
      const method = alreadyCounted ? "GET" : "POST";

      fetch(url, { method })
        .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
        .then((data) => {
          if (typeof data?.count === "number") {
            counterEl.textContent = `${data.count.toLocaleString()} ${counterEl.dataset.label ?? ""}`.trim();
            if (!alreadyCounted) {
              try {
                localStorage.setItem(storageKey, String(Date.now()));
              } catch (error) {
                /* ignore */
              }
            }
          }
        })
        .catch(() => {
          counterEl.parentElement?.setAttribute("hidden", "");
        });
    }
  }
</script>
