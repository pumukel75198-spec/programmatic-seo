---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/5">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    {
      eyebrow && (
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-brand-400">
          {eyebrow}
        </p>
      )
    }
    <h1 class="max-w-3xl text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
      {title}
    </h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-400 sm:text-lg">
          {description}
        </p>
      )
    }
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
