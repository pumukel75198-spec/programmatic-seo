---
const nav = [
  { href: "/apis", label: "APIs" },
  { href: "/alternativen", label: "Alternativen" },
  { href: "/workflows", label: "Workflows" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-[#06070d]/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-cyan-400 text-sm font-bold text-white shadow-lg shadow-brand-500/30">
        PS
      </span>
      <span class="text-sm font-semibold tracking-tight text-white sm:text-base">
        Programmatic<span class="text-brand-400">SEO</span>
      </span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Hauptnavigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
              isActive(item.href)
                ? "bg-white/5 text-white"
                : "text-slate-400 hover:bg-white/5 hover:text-white",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
