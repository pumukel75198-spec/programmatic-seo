---
import Layout from "../../layouts/Layout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import Badge from "../../components/Badge.astro";
import { apis, alternatives, workflows } from "../../lib/content";
import { organizationSchema, websiteSchema } from "../../lib/schema";
import { languages } from "../../i18n/ui";
import { getLocale, localizedPath, t } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);

const stats = [
  { value: `${apis.length}`, label: t(lang, "stats.apis") },
  { value: `${alternatives.length}`, label: t(lang, "stats.alternatives") },
  { value: `${workflows.length}`, label: t(lang, "stats.workflows") },
  { value: "100 %", label: t(lang, "stats.open") },
];

const jsonLd = [websiteSchema(), organizationSchema()];
---

<Layout
  title="APIs, Alternatives & Workflows"
  description={t(lang, "hero.subtitle")}
  keywords={["APIs", "alternatives", "workflows", "programmatic SEO", "automation"]}
  jsonLd={jsonLd}
  lang={lang}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-20 sm:px-6 sm:pb-24 sm:pt-28 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 flex justify-center">
          <Badge tone="brand" class="gap-2 px-3 py-1">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-400"></span>
            </span>
            <span class="notranslate" translate="no">{t(lang, "hero.badge")}</span>
          </Badge>
        </div>

        <h1 class="text-balance text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
          <span>{t(lang, "hero.title1")}</span>
          <span class="gradient-text">{t(lang, "hero.title2")}</span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-relaxed text-slate-400 sm:text-lg">
          {t(lang, "hero.subtitle")}
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={localizedPath(lang, "/apis")}
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:bg-brand-400 sm:w-auto"
          >
            <span>{t(lang, "hero.ctaApis")}</span>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                clip-rule="evenodd"
              />
            </svg>
          </a>
          <a
            href={localizedPath(lang, "/workflows")}
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/20 hover:bg-white/10 sm:w-auto"
          >
            <span>{t(lang, "hero.ctaWorkflows")}</span>
          </a>
        </div>
      </div>

      <!-- Stats -->
      <dl class="mx-auto mt-16 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="rounded-2xl border border-white/10 bg-surface/50 px-4 py-5 text-center backdrop-blur-sm">
              <dt class="text-2xl font-bold text-white sm:text-3xl">{stat.value}</dt>
              <dd class="mt-1 text-xs font-medium uppercase tracking-wider text-slate-500">
                {stat.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Categories -->
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {t(lang, "categories.title")}
        </h2>
        <p class="mt-2 text-slate-400">{t(lang, "categories.subtitle")}</p>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <CategoryCard
        href={localizedPath(lang, "/apis")}
        title={t(lang, "cat.apis.title")}
        label={t(lang, "cat.apis.label")}
        description={t(lang, "cat.apis.desc")}
        count={apis.length}
        accent="brand"
      >
        <svg slot="icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0021 18V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v12a2.25 2.25 0 002.25 2.25z" />
        </svg>
      </CategoryCard>

      <CategoryCard
        href={localizedPath(lang, "/alternatives")}
        title={t(lang, "cat.alt.title")}
        label={t(lang, "cat.alt.label")}
        description={t(lang, "cat.alt.desc")}
        count={alternatives.length}
        accent="cyan"
      >
        <svg slot="icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
      </CategoryCard>

      <CategoryCard
        href={localizedPath(lang, "/workflows")}
        title={t(lang, "cat.wf.title")}
        label={t(lang, "cat.wf.label")}
        description={t(lang, "cat.wf.desc")}
        count={workflows.length}
        accent="emerald"
      >
        <svg slot="icon" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </CategoryCard>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6 lg:px-8">
    <div class="glow relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-surface-2 to-[#0a0c15] px-6 py-12 text-center sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-cyan-500/20 blur-3xl" aria-hidden="true"></div>

      <h2 class="relative text-balance text-2xl font-bold tracking-tight text-white sm:text-3xl">
        {t(lang, "cta.title")}
      </h2>
      <p class="relative mx-auto mt-3 max-w-xl text-pretty text-slate-400">
        {t(lang, "cta.desc")}
      </p>
      <div class="relative mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={localizedPath(lang, "/apis")}
          class="inline-flex w-full items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-200 sm:w-auto"
        >
          <span>{t(lang, "cta.start")}</span>
        </a>
        <a
          href={localizedPath(lang, "/alternatives")}
          class="inline-flex w-full items-center justify-center rounded-xl border border-white/10 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto"
        >
          <span>{t(lang, "cta.compare")}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
