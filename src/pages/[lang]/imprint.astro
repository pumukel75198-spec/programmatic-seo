---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import Placeholder from "../../components/Placeholder.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);
// TODO: remove noindex once the real provider details have been filled in.
---

<Layout
  title="Imprint"
  description="Imprint and provider identification – a placeholder that must be filled with the real details before going live."
  noindex={true}
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="amber">Placeholder</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Imprint
    </h1>
    <p class="mt-3 text-pretty text-slate-400">
      This page is a placeholder. The sections marked with
      <Placeholder>[…]</Placeholder> must be replaced with the real provider
      details before going live.
    </p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">
          Information according to § 5 DDG
        </h2>
        <ul class="mt-3 space-y-1.5">
          <li>
            <span class="text-slate-500">Name / Company:</span>
            <Placeholder>[First and last name / company name]</Placeholder>
          </li>
          <li>
            <span class="text-slate-500">Street:</span>
            <Placeholder>[Street and house number]</Placeholder>
          </li>
          <li>
            <span class="text-slate-500">Postal code / City:</span>
            <Placeholder>[Postal code and city]</Placeholder>
          </li>
          <li>
            <span class="text-slate-500">Country:</span>
            <Placeholder>[Country]</Placeholder>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Represented by</h2>
        <p class="mt-3">
          <Placeholder>[First and last name of the authorized representative]</Placeholder>
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Contact</h2>
        <ul class="mt-3 space-y-1.5">
          <li>
            <span class="text-slate-500">Phone:</span>
            <Placeholder>[Phone number]</Placeholder>
          </li>
          <li>
            <span class="text-slate-500">Email:</span>
            <Placeholder>[Email address]</Placeholder>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">
          VAT identification number
        </h2>
        <p class="mt-3">
          VAT ID according to § 27 a of the German VAT Act:
          <Placeholder>[VAT ID, if applicable]</Placeholder>
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">
          Editorial responsibility
        </h2>
        <p class="mt-3">
          Responsible for content according to § 18 (2) MStV:
          <Placeholder>[Name]</Placeholder>, <Placeholder>[Address]</Placeholder>
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">
          Liability for content
        </h2>
        <p class="mt-3">
          As a service provider, we are responsible for our own content on these
          pages under general law in accordance with § 7 (1) DDG. According to
          §§ 8 to 10 DDG, however, we are not obliged to monitor transmitted or
          stored third-party information or to investigate circumstances that
          indicate illegal activity. Obligations to remove or block the use of
          information under general law remain unaffected.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Liability for links</h2>
        <p class="mt-3">
          Our website contains links to external third-party websites whose
          content we cannot influence. Therefore, we cannot assume any
          liability for this third-party content. The respective provider or
          operator of the linked pages is always responsible for their content.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Copyright</h2>
        <p class="mt-3">
          The content and works created by the site operators on these pages are
          subject to German copyright law. Reproduction, editing, distribution
          and any kind of exploitation outside the limits of copyright require
          the written consent of the respective author or creator.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">
          Consumer dispute resolution
        </h2>
        <p class="mt-3">
          We are neither willing nor obliged to participate in dispute
          resolution proceedings before a consumer arbitration board.
        </p>
      </section>
    </div>
  </article>
</Layout>
