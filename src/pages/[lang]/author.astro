---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);

const author = {
  name: "Thorsten Riedel",
  role: "Founder & Editor",
  location: "Neckarsulm, Germany",
  email: "Tribun692000@gmx.de",
  bio: "Independent developer and automation enthusiast. I build and document API-driven workflows, compare tools and write about programmatic SEO, automation and developer platforms.",
  focus: [
    "API integrations and developer platforms",
    "Workflow automation (Zapier, n8n, Make)",
    "Programmatic SEO and content systems",
    "AI-assisted content pipelines",
  ],
};
---

<Layout
  title="Thorsten Riedel – Author"
  description="Profile of Thorsten Riedel, founder and editor of FlowMatrix, covering APIs, automation and programmatic SEO."
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="brand">Author</Badge>
    <div class="mt-6 flex flex-col items-start gap-5 sm:flex-row sm:items-center">
      <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-cyan-400 text-2xl font-bold text-white shadow-lg shadow-brand-500/30">
        TR
      </div>
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {author.name}
        </h1>
        <p class="mt-1 text-sm text-slate-400">
          {author.role} · {author.location}
        </p>
      </div>
    </div>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">About</h2>
        <p class="mt-3">{author.bio}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Focus areas</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          {author.focus.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Editorial responsibility</h2>
        <p class="mt-3">
          All content on FlowMatrix is reviewed and published under my
          responsibility. Our standards are documented in the
          <a href={`/${lang}/editorial-policy`} class="text-brand-300 underline-offset-4 hover:underline">
            editorial policy
          </a>.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Contact</h2>
        <p class="mt-3">
          <a href={`mailto:${author.email}`} class="text-brand-300 underline-offset-4 hover:underline">
            {author.email}
          </a>
        </p>
      </section>
    </div>
  </article>
</Layout>
