---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);
const lastUpdated = "30. Oktober 2026";
---

<Layout
  title="Affiliate Disclosure"
  description="How FlowMatrix handles affiliate links, sponsorships and commercial relationships – transparently and without influencing our editorial recommendations."
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="emerald">Transparency</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Affiliate Disclosure
    </h1>
    <p class="mt-3 text-pretty text-slate-400">
      We believe you should always know how a website makes money.
    </p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">Current status</h2>
        <p class="mt-3">
          At the time of writing, FlowMatrix has <strong>no active affiliate
          partnerships</strong>. Some outbound links may still carry a referral
          parameter for future use, but they do not currently generate revenue.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">What affiliate links are</h2>
        <p class="mt-3">
          Affiliate links are normal links that contain a tracking parameter. If
          you click one and later buy a product, the vendor may pay us a small
          commission – at no extra cost to you.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Our principles</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li>Commercial relationships never determine whether a tool is recommended.</li>
          <li>We disclose affiliate or sponsored content clearly on the page.</li>
          <li>We only recommend tools we would also mention without a commission.</li>
          <li>Negative findings and limitations are included even for partners.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Sponsorships</h2>
        <p class="mt-3">
          Sponsored placements are always labelled as such. Sponsors have no
          influence over the editorial content of unrelated pages.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Questions</h2>
        <p class="mt-3">
          If anything is unclear, contact us at
          <a href="mailto:Tribun692000@gmx.de" class="text-brand-300 underline-offset-4 hover:underline">
            Tribun692000@gmx.de
          </a>.
        </p>
      </section>

      <p class="text-xs text-slate-500">Last updated: {lastUpdated}</p>
    </div>
  </article>
</Layout>
