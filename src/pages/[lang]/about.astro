---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);

const provider = {
  name: "Thorsten Riedel",
  city: "74172 Neckarsulm",
  country: "Deutschland",
  email: "Tribun692000@gmx.de",
};

const lastUpdated = "30. Oktober 2026";
---

<Layout
  title="About FlowMatrix"
  description="Who is behind FlowMatrix, what we cover and how we research and maintain our API, alternatives and workflow guides."
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="brand">About</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      About FlowMatrix
    </h1>
    <p class="mt-3 text-pretty text-slate-400">
      FlowMatrix is an independent knowledge hub for developers, product teams
      and SEO professionals who build with APIs and automation.
    </p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">Our mission</h2>
        <p class="mt-3">
          The API and automation landscape changes every week. Finding the right
          tool, comparing alternatives and turning them into a reliable workflow
          takes hours of research. FlowMatrix condenses that research into
          structured, linked and continuously updated guides.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">What we cover</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li><strong>APIs</strong> – features, pricing, authentication and use cases.</li>
          <li><strong>Alternatives</strong> – honest comparisons with pros, cons and best-fit audiences.</li>
          <li><strong>Workflows</strong> – step-by-step automation playbooks with a concrete tool stack.</li>
          <li><strong>Insights</strong> – curated news and analysis from the API, automation and SEO space.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">How we work</h2>
        <p class="mt-3">
          Every entry is based on public documentation, vendor pricing pages and
          hands-on evaluation. We link to primary sources wherever possible. Our
          editorial process is described in our
          <a href={`/${lang}/editorial-policy`} class="text-brand-300 underline-offset-4 hover:underline">
            editorial policy
          </a>.
        </p>
        <p class="mt-3">
          Some content is drafted with the help of AI and then reviewed and
          edited by a human before publication. We disclose this transparently
          and never publish unreviewed machine output.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Who is behind FlowMatrix</h2>
        <p class="mt-3">
          FlowMatrix is run by
          <a href={`/${lang}/author`} class="text-brand-300 underline-offset-4 hover:underline">
            {provider.name}
          </a>, an independent developer and automation enthusiast based in
          {provider.city}, {provider.country}.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Contact</h2>
        <p class="mt-3">
          Questions, corrections or partnership requests? Write to
          <a href={`mailto:${provider.email}`} class="text-brand-300 underline-offset-4 hover:underline">
            {provider.email}
          </a>.
        </p>
      </section>

      <p class="text-xs text-slate-500">Last updated: {lastUpdated}</p>
    </div>
  </article>
</Layout>
