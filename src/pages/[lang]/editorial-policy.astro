---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);
const lastUpdated = "30. Oktober 2026";
---

<Layout
  title="Editorial Policy"
  description="How FlowMatrix researches, writes, reviews and corrects its API, alternatives and workflow content – including our AI disclosure."
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="emerald">Editorial</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Editorial Policy
    </h1>
    <p class="mt-3 text-pretty text-slate-400">
      Transparency about how our content is created, reviewed and maintained.
    </p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">1. Research and sources</h2>
        <p class="mt-3">
          We base our guides on primary sources: official API documentation,
          vendor pricing pages, changelogs and hands-on testing. Where we rely on
          secondary reporting, we link to it. Facts that may change quickly
          (pricing, rate limits, features) are checked regularly.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">2. AI-assisted content</h2>
        <p class="mt-3">
          Some drafts, summaries and translations are created with the help of
          large language models. AI output is treated as a draft, never as a
          final source of truth. Every published article is reviewed by a human
          editor before it goes live.
        </p>
        <p class="mt-3">
          We do not use AI to fabricate facts, quotes, statistics or
          testimonials. When a claim cannot be verified, it is removed.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">3. Internal linking and recommendations</h2>
        <p class="mt-3">
          We only link an article to a workflow when there is a genuine thematic
          match. If no workflow fits, we deliberately leave the link out. We
          never assign a workflow arbitrarily just to create a link.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">4. Independence and advertising</h2>
        <p class="mt-3">
          Editorial recommendations are independent of commercial relationships.
          If a page contains affiliate links or sponsored placements, this is
          disclosed clearly. See our
          <a href={`/${lang}/affiliate-disclosure`} class="text-brand-300 underline-offset-4 hover:underline">
            affiliate disclosure
          </a>.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">5. Corrections</h2>
        <p class="mt-3">
          If you spot an error, please email
          <a href="mailto:Tribun692000@gmx.de" class="text-brand-300 underline-offset-4 hover:underline">
            Tribun692000@gmx.de
          </a>. Verified corrections are applied promptly and, where relevant,
          noted in the article.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">6. Update cadence</h2>
        <p class="mt-3">
          Insights are refreshed twice a day. Core API, alternatives and workflow
          pages are reviewed on a rolling basis and updated when pricing,
          features or documentation change.
        </p>
      </section>

      <p class="text-xs text-slate-500">Last updated: {lastUpdated}</p>
    </div>
  </article>
</Layout>
