---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);

const kofi = import.meta.env.PUBLIC_KOFI_URL;
const githubSponsors = import.meta.env.PUBLIC_GITHUB_SPONSORS_URL;
const buyMeACoffee = import.meta.env.PUBLIC_BUYMEACOFFEE_URL;
const hasDonation = Boolean(kofi || githubSponsors || buyMeACoffee);
---

<Layout
  title="Support FlowMatrix"
  description="Support the independent research behind FlowMatrix – via a one-time donation, sponsorship or by sharing the project."
  lang={lang}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="brand">Support</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Support FlowMatrix
    </h1>
    <p class="mt-3 text-pretty text-slate-400">
      FlowMatrix is independent and free to read. If it saves you time, you can
      help keep the research going.
    </p>

    <div class="mt-10 space-y-10 text-sm leading-relaxed text-slate-300">
      <section>
        <h2 class="text-lg font-semibold text-white">Why support us?</h2>
        <p class="mt-3">
          We spend hours testing APIs, comparing tools and maintaining workflow
          guides. There are no paywalls and no tracking. Support helps cover
          hosting, tooling and research time.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">One-time donation</h2>
        {hasDonation ? (
          <div class="mt-4 flex flex-wrap gap-3">
            {kofi && (
              <a
                href={kofi}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-500 to-cyan-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:from-brand-400 hover:to-cyan-400"
              >
                Support on Ko-fi
              </a>
            )}
            {buyMeACoffee && (
              <a
                href={buyMeACoffee}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-yellow-400 px-5 py-3 text-sm font-semibold text-slate-900 transition-colors hover:bg-yellow-300"
              >
                Buy me a coffee
              </a>
            )}
            {githubSponsors && (
              <a
                href={githubSponsors}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-400/50 hover:bg-white/10"
              >
                Sponsor on GitHub
              </a>
            )}
          </div>
        ) : (
          <p class="mt-3">
            Donation options are being set up. In the meantime you can reach us
            at
            <a href="mailto:Tribun692000@gmx.de" class="text-brand-300 underline-offset-4 hover:underline">
              Tribun692000@gmx.de
            </a>.
          </p>
        )}
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white">Free ways to help</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li>Share useful pages with your team.</li>
          <li>Link to FlowMatrix from your blog or newsletter.</li>
          <li>Send corrections and tool suggestions.</li>
        </ul>
      </section>
    </div>
  </article>
</Layout>
