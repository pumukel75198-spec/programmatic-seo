---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import DetailBox from "../../../components/DetailBox.astro";
import Badge from "../../../components/Badge.astro";
import { alternatives, workflows, getRelated, getRelatedByTags } from "../../../lib/content";
import { articleSchema, breadcrumbSchema } from "../../../lib/schema";
import { getToolLink } from "../../../lib/tools";
import { languages } from "../../../i18n/ui";
import { getLocale, localizedPath, t } from "../../../i18n/utils";
import { localizeAlternative, localizeWorkflow } from "../../../i18n/content";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    alternatives.map((entry) => ({
      params: { lang: lang.code, slug: entry.slug },
      props: { entry, lang: lang.code },
    }))
  );
}

const lang = getLocale(Astro.props.lang);
const entry = localizeAlternative(Astro.props.entry, lang);
const related = getRelated(alternatives, entry.slug).map((item) =>
  localizeAlternative(item, lang)
);
const relatedWorkflows = getRelatedByTags(workflows, Astro.props.entry, 3).map(
  (item) => localizeWorkflow(item, lang)
);

const pageTitle = `${entry.title} – ${entry.category}`;
const pageDescription = entry.description;

const { alternatives: altOptions, ...restDetails } = entry.details;
const options = altOptions.map((alt) =>
  typeof alt === "string" ? { name: alt } : alt
);
const recommended = options.find((option) => option.recommended);
const recommendedLink = recommended ? getToolLink(recommended.name) : null;
const recommendedHref = recommendedLink?.href ?? recommended?.url;
const recommendedSponsored = recommendedLink?.sponsored ?? false;

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", url: `/${lang}/` },
    { name: t(lang, "nav.alternatives"), url: `/${lang}/alternatives/` },
    { name: entry.title, url: `/${lang}/alternatives/${entry.slug}/` },
  ]),
  articleSchema(entry, lang),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={`/og/alternatives/${entry.slug}.png`}
  type="article"
  keywords={entry.tags}
  jsonLd={jsonLd}
  lang={lang}
>
  <article>
    <!-- Header -->
    <header class="relative overflow-hidden border-b border-white/5">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <Breadcrumb
          items={[
            { label: "Home", href: localizedPath(lang, "/") },
            {
              label: t(lang, "nav.alternatives"),
              href: localizedPath(lang, "/alternatives"),
            },
            { label: entry.title },
          ]}
        />

        <div class="mt-6 flex flex-wrap gap-2">
          <Badge tone="cyan">{entry.category}</Badge>
          {entry.tags.map((tag) => <Badge tone="slate">{tag}</Badge>)}
        </div>

        <h1 class="mt-4 text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {entry.title}
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-400 sm:text-lg">
          {entry.description}
        </p>
      </div>
    </header>

    <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <!-- Overview details -->
      <h2 class="text-xl font-semibold text-white sm:text-2xl">Overview</h2>
      <DetailBox details={restDetails} />

      <!-- Top recommendation -->
      {
        recommended && (
          <div class="mt-8 rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-emerald-500/10 to-transparent p-6">
            <Badge tone="emerald">Top recommendation</Badge>
            <h3 class="mt-3 text-xl font-semibold text-white">
              {recommended.name}
            </h3>
            {recommended.description && (
              <p class="mt-2 text-sm leading-relaxed text-slate-400">
                {recommended.description}
              </p>
            )}
            {recommendedHref && (
              <a
                href={recommendedHref}
                target="_blank"
                rel={recommendedSponsored ? "noopener sponsored" : "noopener noreferrer"}
                class="mt-4 inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-400"
              >
                Visit {recommended.name}
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                  <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                </svg>
              </a>
            )}
          </div>
        )
      }

      <!-- Alternatives with pros/cons -->
      <div class="mt-12">
        <h2 class="text-xl font-semibold text-white sm:text-2xl">
          Recommended alternatives
        </h2>
        <p class="mt-2 text-sm text-slate-400">
          Hand-picked tools with pros, cons and direct links.
        </p>

        <div class="mt-6 space-y-5">
          {
            options.map((option, index) => {
              const link = getToolLink(option.name);
              const href = link?.href ?? option.url;
              const sponsored = link?.sponsored ?? false;
              return (
                <div
                  class:list={[
                    "rounded-2xl border p-6",
                    option.recommended
                      ? "border-emerald-500/30 bg-emerald-500/5"
                      : "border-white/10 bg-surface/50",
                  ]}
                >
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-cyan-500/10 text-sm font-bold text-cyan-300 ring-1 ring-inset ring-cyan-500/20">
                        {index + 1}
                      </span>
                      <div>
                        <div class="flex flex-wrap items-center gap-2">
                          <h3 class="text-lg font-semibold text-white">
                            {option.name}
                          </h3>
                          {option.recommended && (
                            <Badge tone="emerald">Recommended</Badge>
                          )}
                        </div>
                        {option.bestFor && (
                          <p class="mt-0.5 text-xs text-slate-500">
                            Best for: {option.bestFor}
                          </p>
                        )}
                      </div>
                    </div>

                    {href && (
                      <a
                        href={href}
                        target="_blank"
                        rel={sponsored ? "noopener sponsored" : "noopener noreferrer"}
                        class="inline-flex items-center gap-1.5 rounded-lg bg-brand-500 px-3 py-1.5 text-xs font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:bg-brand-400"
                      >
                        Visit {option.name}
                        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                        </svg>
                      </a>
                    )}
                  </div>

                  {option.description && (
                    <p class="mt-3 text-sm leading-relaxed text-slate-400">
                      {option.description}
                    </p>
                  )}

                  {(option.pros || option.cons) && (
                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                      {option.pros && (
                        <div>
                          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-emerald-400">
                            Pros
                          </p>
                          <ul class="space-y-1.5">
                            {option.pros.map((pro) => (
                              <li class="flex items-start gap-2 text-sm text-slate-300">
                                <span class="mt-1 text-emerald-400">+</span>
                                {pro}
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                      {option.cons && (
                        <div>
                          <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-rose-400">
                            Cons
                          </p>
                          <ul class="space-y-1.5">
                            {option.cons.map((con) => (
                              <li class="flex items-start gap-2 text-sm text-slate-300">
                                <span class="mt-1 text-rose-400">−</span>
                                {con}
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- Related workflows -->
      {
        relatedWorkflows.length > 0 && (
          <section class="mt-12 border-t border-white/5 pt-10">
            <h2 class="text-xl font-semibold text-white sm:text-2xl">Related workflows</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {relatedWorkflows.map((item) => (
                <a
                  href={localizedPath(lang, `/workflows/${item.slug}`)}
                  class="group card-hover rounded-xl border border-white/10 bg-surface/50 p-5"
                >
                  <p class="text-sm font-semibold text-white group-hover:text-emerald-300">
                    {item.title}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">{item.category}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Related comparisons -->
      {
        related.length > 0 && (
          <section class="mt-12 border-t border-white/5 pt-10">
            <h2 class="text-xl font-semibold text-white sm:text-2xl">More comparisons</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {related.map((item) => (
                <a
                  href={localizedPath(lang, `/alternatives/${item.slug}`)}
                  class="group card-hover rounded-xl border border-white/10 bg-surface/50 p-5"
                >
                  <p class="text-sm font-semibold text-white group-hover:text-cyan-300">
                    {item.title}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">{item.category}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </section>
  </article>
</Layout>
