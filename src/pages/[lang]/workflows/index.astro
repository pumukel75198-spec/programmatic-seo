---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ContentCard from "../../../components/ContentCard.astro";
import { workflows } from "../../../lib/content";
import { itemListSchema } from "../../../lib/schema";
import { languages } from "../../../i18n/ui";
import { getLocale, localizedPath, t } from "../../../i18n/utils";
import { localizeWorkflow } from "../../../i18n/content";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);
const localizedWorkflows = workflows.map((workflow) =>
  localizeWorkflow(workflow, lang)
);

const jsonLd = itemListSchema(
  "Workflows – automation step by step",
  localizedWorkflows.map((workflow) => ({
    name: workflow.title,
    url: `/${lang}/workflows/${workflow.slug}/`,
  }))
);
---

<Layout
  title="Workflows – automation step by step"
  description={t(lang, "cat.wf.desc")}
  keywords={["workflows", "automation", "content", "sales", "programmatic SEO"]}
  jsonLd={jsonLd}
  lang={lang}
>
  <PageHeader
    eyebrow={t(lang, "cat.wf.label")}
    title={t(lang, "cat.wf.title")}
    description={t(lang, "cat.wf.desc")}
  >
    <p class="text-sm text-slate-500">
      {localizedWorkflows.length} {t(lang, "stats.workflows")}
    </p>
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        localizedWorkflows.map((workflow) => (
          <ContentCard
            href={localizedPath(lang, `/workflows/${workflow.slug}`)}
            title={workflow.title}
            description={workflow.description}
            meta={`${workflow.details.difficulty} · ${workflow.details.duration}`}
            tags={workflow.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
