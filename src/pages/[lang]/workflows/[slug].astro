---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import DetailBox from "../../../components/DetailBox.astro";
import CTA from "../../../components/CTA.astro";
import Badge from "../../../components/Badge.astro";
import PremiumDownload from "../../../components/PremiumDownload.astro";
import { workflows, getRelated } from "../../../lib/content";
import { breadcrumbSchema, howToSchema } from "../../../lib/schema";
import { languages } from "../../../i18n/ui";
import { getLocale, localizedPath, t } from "../../../i18n/utils";
import { localizeWorkflow } from "../../../i18n/content";

export function getStaticPaths() {
  return languages.flatMap((lang) =>
    workflows.map((workflow) => ({
      params: { lang: lang.code, slug: workflow.slug },
      props: { workflow, lang: lang.code },
    }))
  );
}

const lang = getLocale(Astro.props.lang);
const workflow = localizeWorkflow(Astro.props.workflow, lang);
const related = getRelated(workflows, workflow.slug).map((item) =>
  localizeWorkflow(item, lang)
);

const pageTitle = `${workflow.title} – ${workflow.category}`;
const pageDescription = workflow.description;

const difficultyTone =
  workflow.details.difficulty === "Beginner"
    ? "emerald"
    : workflow.details.difficulty === "Advanced"
      ? "amber"
      : "brand";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", url: `/${lang}/` },
    { name: t(lang, "nav.workflows"), url: `/${lang}/workflows/` },
    { name: workflow.title, url: `/${lang}/workflows/${workflow.slug}/` },
  ]),
  howToSchema(workflow),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  keywords={workflow.tags}
  jsonLd={jsonLd}
  lang={lang}
>
  <article>
    <!-- Header -->
    <header class="relative overflow-hidden border-b border-white/5">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <Breadcrumb
          items={[
            { label: "Home", href: localizedPath(lang, "/") },
            {
              label: t(lang, "nav.workflows"),
              href: localizedPath(lang, "/workflows"),
            },
            { label: workflow.title },
          ]}
        />

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <Badge tone={difficultyTone}>{workflow.details.difficulty}</Badge>
          <Badge tone="slate">{workflow.category}</Badge>
          {workflow.tags.map((tag) => <Badge tone="slate">{tag}</Badge>)}
        </div>

        <h1 class="mt-4 text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {workflow.title}
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-400 sm:text-lg">
          {workflow.description}
        </p>
      </div>
    </header>

    <!-- Details -->
    <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">Workflow details</h2>
      <DetailBox details={workflow.details} />

      <PremiumDownload
        slug={workflow.slug}
        title={workflow.title}
        price="€4.99"
      />

      <CTA
        title="Place your tool in this workflow"
        description="Showcase your product right where developers look for the right tools for their automation."
        ctaLabel="Request sponsorship"
        ctaHref="mailto:sponsoring@flowmatrix.dev"
      />

      <!-- Related workflows -->
      {
        related.length > 0 && (
          <section class="mt-12 border-t border-white/5 pt-10">
            <h2 class="text-xl font-semibold text-white sm:text-2xl">More workflows</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {related.map((item) => (
                <a
                  href={localizedPath(lang, `/workflows/${item.slug}`)}
                  class="group card-hover rounded-xl border border-white/10 bg-surface/50 p-5"
                >
                  <p class="text-sm font-semibold text-white group-hover:text-emerald-300">
                    {item.title}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">{item.category}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </section>
  </article>
</Layout>
