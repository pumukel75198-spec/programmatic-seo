---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import { languages } from "../../i18n/ui";
import { getLocale } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);

const packages = [
  {
    name: "Featured listing",
    price: "from €99 / month",
    description:
      "Your API or tool highlighted at the top of a relevant category page, clearly labelled as sponsored.",
    points: [
      "Placement on a category or comparison page",
      "Logo, short description and direct link",
      "Monthly performance summary",
    ],
  },
  {
    name: "Workflow sponsorship",
    price: "from €149 / month",
    description:
      "Your tool integrated into a relevant step-by-step workflow with a sponsored note.",
    points: [
      "Contextual placement inside a workflow",
      "Sponsored disclosure on the page",
      "Evergreen visibility",
    ],
  },
  {
    name: "Newsletter / Insights sponsorship",
    price: "on request",
    description:
      "A short sponsored mention in our insights feed or a dedicated sponsored article.",
    points: [
      "Reach developers and SEO teams",
      "Clearly labelled as sponsored",
      "Content reviewed by our editor",
    ],
  },
];
---

<Layout
  title="Advertise on FlowMatrix"
  description="Reach developers, product teams and SEO professionals with clearly labelled sponsored listings, workflow sponsorships and insights placements."
  lang={lang}
>
  <article class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <Badge tone="brand">Advertise</Badge>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Advertise on FlowMatrix
    </h1>
    <p class="mt-3 max-w-2xl text-pretty text-slate-400">
      FlowMatrix reaches developers, product teams and SEO professionals who are
      actively evaluating APIs and automation tools. All paid placements are
      clearly labelled and never disguised as editorial content.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {packages.map((pkg) => (
        <section class="rounded-2xl border border-white/10 bg-surface/50 p-6">
          <h2 class="text-lg font-semibold text-white">{pkg.name}</h2>
          <p class="mt-1 text-sm font-medium text-brand-300">{pkg.price}</p>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">
            {pkg.description}
          </p>
          <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-slate-300">
            {pkg.points.map((point) => <li>{point}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <section class="mt-10 rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-500/10 to-transparent p-6">
      <h2 class="text-lg font-semibold text-white">Request a media kit</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-400">
        Tell us about your product and the category you want to reach. We will
        send current traffic numbers, available placements and pricing.
      </p>
      <a
        href="mailto:Tribun692000@gmx.de?subject=Advertising%20on%20FlowMatrix"
        class="mt-4 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-brand-500 to-cyan-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:from-brand-400 hover:to-cyan-400"
      >
        Contact Tribun692000@gmx.de
      </a>
    </section>

    <section class="mt-10 text-sm leading-relaxed text-slate-400">
      <h2 class="text-lg font-semibold text-white">Our advertising principles</h2>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        <li>Paid placements are always labelled as sponsored.</li>
        <li>Sponsors have no influence on editorial recommendations.</li>
        <li>We only accept products relevant to our audience.</li>
        <li>We reserve the right to decline unsuitable advertisers.</li>
      </ul>
    </section>
  </article>
</Layout>
