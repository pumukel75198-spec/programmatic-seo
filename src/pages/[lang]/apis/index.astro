---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import ContentCard from "../../../components/ContentCard.astro";
import { apis } from "../../../lib/content";
import { itemListSchema } from "../../../lib/schema";
import { languages } from "../../../i18n/ui";
import { getLocale, localizedPath, t } from "../../../i18n/utils";
import { localizeApi } from "../../../i18n/content";

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang: lang.code },
  }));
}

const lang = getLocale(Astro.props.lang);
const localizedApis = apis.map((api) => localizeApi(api, lang));

const jsonLd = itemListSchema(
  "APIs – curated directory",
  localizedApis.map((api) => ({ name: api.title, url: `/apis/${api.slug}/` }))
);
---

<Layout
  title="APIs – curated directory"
  description={t(lang, "cat.apis.desc")}
  keywords={["APIs", "interfaces", "AI", "payments", "backend"]}
  jsonLd={jsonLd}
  lang={lang}
>
  <PageHeader
    eyebrow={t(lang, "cat.apis.label")}
    title={t(lang, "cat.apis.title")}
    description={t(lang, "cat.apis.desc")}
  >
    <p class="text-sm text-slate-500">
      {localizedApis.length} {t(lang, "stats.apis")}
    </p>
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        localizedApis.map((api) => (
          <ContentCard
            href={localizedPath(lang, `/apis/${api.slug}`)}
            title={api.title}
            description={api.description}
            meta={api.category}
            tags={api.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
