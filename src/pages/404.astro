---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="The requested page does not exist."
  noindex={true}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center sm:px-6 lg:px-8">
    <p class="gradient-text text-7xl font-bold tracking-tight sm:text-9xl">404</p>
    <h1 class="mt-4 text-2xl font-bold text-white sm:text-3xl">
      This page could not be found
    </h1>
    <p class="mt-3 max-w-md text-pretty text-slate-400">
      The page may have been moved or the link is outdated. Return to the home
      page and find what you are looking for.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-500/30 transition-colors hover:bg-brand-400"
    >
      Back to home
    </a>
  </section>
</Layout>
