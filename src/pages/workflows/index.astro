---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContentCard from "../../components/ContentCard.astro";
import { workflows } from "../../lib/content";
import { itemListSchema } from "../../lib/schema";

const jsonLd = itemListSchema(
  "Workflows – automation step by step",
  workflows.map((workflow) => ({
    name: workflow.title,
    url: `/workflows/${workflow.slug}/`,
  }))
);
---

<Layout
  title="Workflows – automation step by step"
  description="Proven workflows for content, sales and programmatic SEO – including the tool stack and step-by-step instructions."
  keywords={["workflows", "automation", "content", "sales", "programmatic SEO"]}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Automation"
    title="Workflows that actually work"
    description="Step-by-step guides for scalable processes – from content automation to the programmatic SEO pipeline."
  >
    <p class="text-sm text-slate-500">{workflows.length} workflows available</p>
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        workflows.map((workflow) => (
          <ContentCard
            href={`/workflows/${workflow.slug}`}
            title={workflow.title}
            description={workflow.description}
            meta={`${workflow.details.difficulty} · ${workflow.details.duration}`}
            tags={workflow.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
