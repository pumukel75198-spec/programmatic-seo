---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContentCard from "../../components/ContentCard.astro";
import { apis } from "../../lib/content";
import { itemListSchema } from "../../lib/schema";

const jsonLd = itemListSchema(
  "APIs – curated directory",
  apis.map((api) => ({ name: api.title, url: `/apis/${api.slug}/` }))
);
---

<Layout
  title="APIs – curated directory"
  description="Discover curated APIs for AI, payments, backend and communication – with features, pricing and ratings."
  keywords={["APIs", "interfaces", "AI", "payments", "backend"]}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="API directory"
    title="The right API for your project"
    description="A structured overview of powerful interfaces – from generative AI to payment infrastructure."
  >
    <p class="text-sm text-slate-500">{apis.length} APIs in the directory</p>
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        apis.map((api) => (
          <ContentCard
            href={`/apis/${api.slug}`}
            title={api.title}
            description={api.description}
            meta={api.category}
            tags={api.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
