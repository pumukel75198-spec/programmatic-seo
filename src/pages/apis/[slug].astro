---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DetailBox from "../../components/DetailBox.astro";
import CTA from "../../components/CTA.astro";
import Badge from "../../components/Badge.astro";
import { apis, getRelated } from "../../lib/content";
import { breadcrumbSchema, softwareApplicationSchema } from "../../lib/schema";

export function getStaticPaths() {
  return apis.map((api) => ({
    params: { slug: api.slug },
    props: { api },
  }));
}

const { api } = Astro.props;
const related = getRelated(apis, api.slug);

const pageTitle = `${api.title} – ${api.category}`;
const pageDescription = api.description;

const jsonLd = [
  breadcrumbSchema([
    { name: "Start", url: "/" },
    { name: "APIs", url: "/apis/" },
    { name: api.title, url: `/apis/${api.slug}/` },
  ]),
  softwareApplicationSchema(api),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="article"
  keywords={api.tags}
  jsonLd={jsonLd}
>
  <article>
    <!-- Header -->
    <header class="relative overflow-hidden border-b border-white/5">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <Breadcrumb
          items={[
            { label: "Start", href: "/" },
            { label: "APIs", href: "/apis" },
            { label: api.title },
          ]}
        />

        <div class="mt-6 flex flex-wrap gap-2">
          <Badge tone="brand">{api.category}</Badge>
          {api.tags.map((tag) => <Badge tone="slate">{tag}</Badge>)}
        </div>

        <h1 class="mt-4 text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
          {api.title}
        </h1>
        <p class="mt-4 max-w-2xl text-pretty text-base leading-relaxed text-slate-400 sm:text-lg">
          {api.description}
        </p>
      </div>
    </header>

    <!-- Details -->
    <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="text-xl font-semibold text-white sm:text-2xl">Details</h2>
      <DetailBox details={api.details} />

      <CTA
        title="API in dieser Kategorie bewerben?"
        description="Erreiche Entwickler und SEO-Teams, die aktiv nach passenden APIs suchen. Platz für Affiliate- und Sponsoring-Links."
        ctaLabel="Sponsoring anfragen"
        ctaHref="mailto:sponsoring@example.com"
      />

      <!-- Verwandte APIs -->
      {
        related.length > 0 && (
          <section class="mt-12 border-t border-white/5 pt-10">
            <h2 class="text-xl font-semibold text-white sm:text-2xl">Weitere APIs</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
              {related.map((item) => (
                <a
                  href={`/apis/${item.slug}`}
                  class="group card-hover rounded-xl border border-white/10 bg-surface/50 p-5"
                >
                  <p class="text-sm font-semibold text-white group-hover:text-brand-300">
                    {item.title}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">{item.category}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </section>
  </article>
</Layout>
