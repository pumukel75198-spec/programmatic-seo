---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContentCard from "../../components/ContentCard.astro";
import { alternatives } from "../../lib/content";
import { itemListSchema } from "../../lib/schema";

const jsonLd = itemListSchema(
  "Alternatives – tool comparisons",
  alternatives.map((entry) => ({
    name: entry.title,
    url: `/alternatives/${entry.slug}/`,
  }))
);
---

<Layout
  title="Alternatives – tool comparisons"
  description="The best alternatives to popular tools – with pros, cons, pricing and target audiences."
  keywords={["alternatives", "tool comparison", "productivity", "automation", "design"]}
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="Tool comparisons"
    title="Find better alternatives"
    description="Compare established tools with strong alternatives – including pros and cons so you can make the right choice."
  >
    <p class="text-sm text-slate-500">{alternatives.length} comparisons available</p>
  </PageHeader>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        alternatives.map((entry) => (
          <ContentCard
            href={`/alternatives/${entry.slug}`}
            title={entry.title}
            description={entry.description}
            meta={`${entry.details.alternatives.length} alternatives`}
            tags={entry.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
