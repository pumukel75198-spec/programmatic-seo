# FlowMatrix – English-only consolidation (Cloudflare Pages)
#
# The site used to be built in English and German. All German URLs are now
# permanently redirected to their English counterparts so previously indexed
# /de/... URLs never turn into 404s.
#
# Order matters: first match wins.

# --- German locale -> English locale (permanent) ---
/de/*           /en/:splat        301
/de             /en/              301

# --- Legacy unlocalized content paths (permanent) ---
/apis           /en/apis/          301
/apis/*         /en/apis/:splat    301
/alternatives   /en/alternatives/  301
/alternatives/* /en/alternatives/:splat 301
/workflows      /en/workflows/     301
/workflows/*    /en/workflows/:splat 301

# --- Legacy legal pages (permanent) ---
/imprint        /en/imprint/       301
/privacy        /en/privacy/       301

# Root -> English home (permanent; English-only is the final locale decision).
/              /en/               301
