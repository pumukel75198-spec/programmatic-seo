{
  "name": "programmatic-seo",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-api-scripts.mjs && node scripts/validate-api-scripts.mjs && node scripts/clean-public-downloads.mjs && node scripts/generate-og.mjs && node scripts/generate-pdfs.mjs && node scripts/validate-pdfs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-data.js",
    "generate:batch": "node scripts/generate-batch.mjs",
    "enrich:alternatives": "node scripts/enrich-alternatives.mjs",
    "enrich:workflows": "node scripts/enrich-workflows.mjs",
    "enrich:workflow-details": "node scripts/enrich-workflow-details.mjs",
    "insights:generate": "node scripts/generate-insights.mjs",
    "api-scripts:generate": "node scripts/generate-api-scripts.mjs",
    "api-scripts:test": "node scripts/test-api-scripts.mjs",
    "api-scripts:test:offline": "node scripts/test-api-scripts.mjs --offline",
    "api-scripts:validate": "node scripts/validate-api-scripts.mjs",
    "api-scripts:upload": "node scripts/upload-api-scripts.mjs",
    "pdf:generate": "node scripts/generate-pdfs.mjs",
    "pdf:check": "node scripts/check-pdf-quality.mjs",
    "pdf:check:fix": "node scripts/check-pdf-quality.mjs --fix",
    "pdf:validate": "node scripts/validate-pdfs.mjs",
    "pdf:upload": "node scripts/upload-pdfs.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "deploy:init": "wrangler pages project create programmatic-seo --production-branch=main",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=programmatic-seo",
    "cf:preview": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "wrangler": "^4.154.0"
  }
}
