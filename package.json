{
  "name": "programmatic-seo",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-og.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "node scripts/validate-data.js",
    "enrich:alternatives": "node scripts/enrich-alternatives.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "deploy:init": "wrangler pages project create programmatic-seo --production-branch=main",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=programmatic-seo",
    "cf:preview": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.154.0"
  }
}
