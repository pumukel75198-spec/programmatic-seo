{
  "name": "programmatic-seo",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-translation-manifest.mjs && node scripts/clean-public-downloads.mjs && node scripts/generate-og.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pipeline:run": ".venv/bin/python -m pipeline.run_batch",
    "generate:batch": "npm run pipeline:run --",
    "newsletter:send": "node scripts/send-newsletter.mjs",
    "newsletter:preview": "node scripts/send-newsletter.mjs --dry-run",
    "newsletter:sync": "node scripts/sync-newsletter.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "insights:generate": "node scripts/generate-insights.mjs",
    "insights:expand": "node scripts/expand-insights.mjs",
    "i18n:manifest": "node scripts/generate-translation-manifest.mjs",
    "i18n:translate": "node scripts/translate-de-overrides.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "monetization:check": "node scripts/check-monetization.mjs",
    "monetization:check:warn": "node scripts/check-monetization.mjs --warn",
    "deploy:init": "wrangler pages project create programmatic-seo --production-branch=main",
    "deploy": "npm run monetization:check:warn && npm run build && wrangler pages deploy dist --project-name=programmatic-seo",
    "cf:preview": "wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "fast-xml-parser": "^5.11.2",
    "marked": "^18.1.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
