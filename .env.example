# Lemon Squeezy checkout URL used by <LemonButton />
# Example: https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_LEMON_CHECKOUT_URL=

# Optional: dedicated checkout for the 4,99 € Premium Workflow PDF
PUBLIC_LEMON_WORKFLOW_CHECKOUT_URL=

# Dedicated checkout for the 19,99 € Python starter script product
PUBLIC_LEMON_SCRIPT_CHECKOUT_URL=

# Download-Gate Worker (schützt die Premium-PDFs, siehe worker/download-gate/)
# Example: https://flowmatrix-download-gate.<subdomain>.workers.dev
PUBLIC_DOWNLOAD_GATE_URL=

# --- Worker-Secrets (NICHT im Frontend, nur via `wrangler secret put`) ---
# DOWNLOAD_TOKEN_SECRET=<openssl rand -hex 32>
# LEMON_PRODUCT_MAP={"variant:123456":{"type":"single","slugs":["content-automation"]}}

# Global affiliate reference appended to sponsored tool links
PUBLIC_AFFILIATE_REF=flowmatrix

# Cloudflare Worker URL for the global visitor counter (see worker/)
# Example: https://flowmatrix-visitor-counter.<subdomain>.workers.dev
PUBLIC_VISITOR_COUNTER_URL=

# Cloudflare Worker URL for the protected PDF download gate (see worker/download-gate/)
# Example: https://flowmatrix-download-gate.<subdomain>.workers.dev
PUBLIC_DOWNLOAD_GATE_URL=

# Cloudflare Web Analytics token (Dashboard -> Web Analytics -> Add site)
# When set, the privacy-friendly beacon is injected into every page.
PUBLIC_CF_ANALYTICS_TOKEN=

# OpenRouter key for the content pipelines (never commit the real key)
OPENROUTER_API_KEY=
